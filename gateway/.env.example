# ==============================================================================
# WoL Gateway Ortam Değişkenleri Şablonu (.env.example)
# ------------------------------------------------------------------------------
# Bu dosyayı '.env' adıyla kopyalayıp kendi sisteminize göre doldurunuz.
# '.env' dosyası KESİNLİKLE Git'e gönderilmemelidir (.gitignore'da korunuyor).
#
# ÜRETİM UYARISI: Aşağıdaki değerlerin çoğu 'güvenli varsayılan' seçilmiştir.
# Varsayılanları değiştirmeden servis başlatmayın.
# ==============================================================================

# --- GÜVENLİK ---
# API uç noktaları ve MQTT komutları için güçlü, rastgele bir token.
# Üretin:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Firmware tarafındaki karşılığı include/secrets.h içindeki WAKE_AUTH_TOKEN
# ile BİREBİR aynı olmalıdır (en az 16 karakter).
WOL_AUTH_TOKEN=CHANGE_ME_generate_with_secrets_token_hex_32

# --- HEDEF CİHAZ (PC/İŞ İSTASYONU) ---
# Şablon değerini kullanmayın; gateway başlangıçta bunu hata olarak loglar.
TARGET_MAC=00:11:22:33:44:55
# Doğrudan broadcast hedefi. CGNAT arkasındaysa genelde router'ın WAN IP'si olur.
TARGET_BROADCAST_IP=255.255.255.255
WOL_PORT=9

# /api/heartbeat ile kaydedilen IP gerçekten WoL hedefi olarak kullanılsın mı?
# CGNAT nedeniyle dış IP değişiyorsa True yapın. Yanlış/ele geçirilmiş bir kayıt
# tüm WoL trafiğini yanlış adrese yönlendireceği için varsayılan False'tur.
PREFER_RECORDED_IP=false

# --- GATEWAY HTTP SUNUCUSU ---
# DİKKAT: 0.0.0.0 tüm arayüzlere dinler. VPS internete açıksa tercih edilen
# değer 127.0.0.1'dir ve yalnızca Tailscale/SSH tüneli ile erişilir.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
WAKE_COOLDOWN_SECONDS=15.0

# --- CANLILIK KONTROLÜ (NON-BLOCKING) ---
# Hedefin Tailscale IP'si + worker sağlık portu (LOCATION_WEBHOOK_PORT).
# 127.0.0.1 bırakılırsa gateway KENDİSİNİ yoklar; durum paneli yanıltıcı olur.
HEALTH_PROBE_HOST=100.94.69.22
HEALTH_PROBE_PORT=8085
HEALTH_CACHE_TTL=5.0

# --- MQTT KÖPRÜ AYARLARI ---
# Varsayılan KAPALI: doğrudan UDP kanalı tek başına yeterlidir.
# Hedef CGNAT arkasındaysa ve EMNİYETLİ bir broker kullanıyorsanız açın.
MQTT_ENABLED=false
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_USER=
MQTT_PASSWORD=

# TLS üretim için zorunlu tavsiye edilir. CA sertifikası verilmezse
# bağlantı, doğrulama yapılamayacağı için iptal edilir (sessiz düşmez).
MQTT_TLS_ENABLED=true
MQTT_CA_CERT_FILE=/etc/wol-gateway/ca.crt

# Topic adını tahmin edilemez yapın; kanal adı internete açıktır.
MQTT_TOPIC_PREFIX=edge/wol/device
