# ==============================================================================
# WoL Gateway Ortam Değişkenleri Şablonu (.env.example)
# ==============================================================================
# Bu dosyayı '.env' adıyla kopyalayıp kendi sisteminize göre doldurunuz.
# '.env' dosyası KESİNLİKLE Git'e gönderilmemelidir.
# ==============================================================================

# --- GÜVENLİK ---
# API uç noktaları ve MQTT komutları için güçlü, rastgele bir token belirleyin
WOL_AUTH_TOKEN=super_secret_high_entropy_token_2026

# --- HEDEF CİHAZ (PC/İŞ İSTASYONU) ---
TARGET_MAC=00:11:22:33:44:55
TARGET_BROADCAST_IP=255.255.255.255
WOL_PORT=9

# --- GATEWAY HTTP SUNUCUSU ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
WAKE_COOLDOWN_SECONDS=15.0

# --- CANLILIK KONTROLÜ (NON-BLOCKING) ---
HEALTH_PROBE_HOST=127.0.0.1
HEALTH_PROBE_PORT=22
HEALTH_CACHE_TTL=5.0

# --- MQTT KÖPRÜ AYARLARI ---
MQTT_ENABLED=true
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=edge/wol/device
